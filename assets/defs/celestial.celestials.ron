[
/*
    (
        // the name of the planet. must be unique
        id: "test",
        name: "Test",

        // radius of the planet
        radius: 1000.,

        /// mass of the planet
        mu: 3.0e6,

        // technical detail about the chunk
        chunk: (
            // how many vertices per chunk are used
            cells: 32,

            // how often the cube gets subdivided
            max_depth: 6,

            // how fast the subdivisions get calculated
            detail: 0.2,
        ),

        // the world gen noise values
        shape: (
            // the Sphere of influence radius
            soi: 1_000.,

            // how high the terrain can get. 
            // higher values equals higher mountains
            amplitude: 10.,

            // how big the texture can get (the size of the noise). 
            // higher values equals more detail
            frequency: 6.,

            // how many iterations the noise apply. 
            // more iterations equals finer detail
            octaves: 5,

            // the factor of how much stronger the octaves get
            // higher values make the terrain rougher
            lacunarity: 2.,

            // the factor the amplitude scales. 
            // later octaves get smaller hills with gain < 1.0
            gain: 0.5,
        ),

        // color defintions of the celestial
        color: [
            // can be read like this:
            // all values below <below> get the color <rgb>
            // 
            // <below> values range from -1.0 to 1.0
            // colors are in rgb format from 0 to 255
            (
                below: -0.5, 
                rgb: [0, 0, 255]
            ),
            (
                below: 0.0, 
                rgb: [0, 255, 0]
            ),
            (
                below: 0.7, 
                rgb: [100, 100, 100]
            ),
            (
                below: 1.0, 
                rgb: [255, 255, 255]
            ),
        ]
    ),
*/
    (
        id: "earthlike",
        name: "Verdan",

        mu: 8.82e7,

        chunk: (
            cells: 32,
            max_depth: 5,
            detail: 0.2,
        ),

        shape: (
            radius: 3000.,
            amplitude: 60.,
            frequency: 6.,
            octaves: 5,
            lacunarity: 2.,
            gain: 0.5,
            soi: 35_000.,
        ),

        atmosphere: Some((
            radius: 1_000_000.,
            height: 60_000.,
            scattering: [5.802, 13.558, 33.1],
            albedo: 0.3,
        )),

        color: [
            (
                below: 0.0, 
                rgb: [0, 0, 255]
            ),
            (
                below: 0.1, 
                rgb: [0, 100, 255]
            ),
            (
                below: 0.4, 
                rgb: [0, 255, 0]
            ),
            (
                below: 0.7, 
                rgb: [100, 100, 100]
            ),
            (
                below: 1.0, 
                rgb: [255, 255, 255]
            ),
        ]
    ),

